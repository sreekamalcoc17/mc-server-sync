{
  "name": "minesync",
  "version": "1.0.0",
  "description": "Distributed Minecraft Server Hosting - Sync your server across PCs",
  "author": "MineSync User",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "build:linux": "npm run build && electron-builder --linux AppImage",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.minesync.app",
    "productName": "MineSync",
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.7.0",
    "electron-packager": "^17.1.2",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}